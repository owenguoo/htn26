# Generate a key: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SWARM_API_KEY=replace-with-a-random-secret-before-serving
SWARM_BACKEND=yoloe
SWARM_ENABLE_REID=true
SWARM_DEVICE=cpu
SWARM_BATCH_SIZE=4
SWARM_QUEUE_CAPACITY=64
SWARM_TIMEOUT_SECONDS=30
# For SAM 3, accept access terms first and set HF_TOKEN in the environment.
