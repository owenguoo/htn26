# Model server stays private or behind authenticated HTTPS.
SWARM_INFERENCE_URL=http://127.0.0.1:8001
SWARM_INFERENCE_API_KEY=replace-with-model-service-key
SWARM_BRIDGE_KEY=replace-with-random-bridge-secret
SWARM_HUB_URL=http://127.0.0.1:8000
SWARM_MAX_PHONES=64
# Missing inference configuration leaves mock rehearsal enabled.
# Set only for Baseten; keep this server-side. URL ends in /environments/production/sync.
SWARM_BASETEN_API_KEY=
